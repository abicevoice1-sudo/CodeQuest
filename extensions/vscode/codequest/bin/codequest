#!/usr/bin/env node
/**
 * codequest — deterministic static analyzer for the CodeQuest drop-in.
 * Zero dependencies. Node 18+. Fully offline. Never touches the network.
 *
 *   scan [dir]              build .codequest/graph.json + .codequest/repo-map.md
 *   map [dir]               print the repo map
 *   modules [dir]           list modules + exports
 *   blast-radius <file> [dir]   impact matrix for a module (accepts partial path)
 *   story <entry> [dir]     static execution trace from an entry point
 *
 * Add --json to any command for machine-readable output.
 */
'use strict';

const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');

const VERSION = '1.0.0';
const SKIP_DIRS = new Set(['node_modules', '.git', 'dist', 'build', 'coverage', '.next',
  'vendor', '__pycache__', '.venv', 'venv', 'target', '.codequest', '.idea', '.vscode']);
const EXT_LANG = {
  '.js': 'javascript', '.jsx': 'javascript', '.mjs': 'javascript', '.cjs': 'javascript',
  '.ts': 'typescript', '.tsx': 'typescript',
  '.py': 'python', '.go': 'go', '.java': 'java', '.rb': 'ruby', '.php': 'php',
};
// Non-code files the analyzer inventories (and shows in the repo map).
const ASSET_KIND = {
  '.json': 'config', '.yaml': 'config', '.yml': 'config', '.toml': 'config', '.ini': 'config',
  '.md': 'doc', '.mdx': 'doc', '.rst': 'doc', '.txt': 'doc', '.pdf': 'doc',
  '.png': 'image', '.jpg': 'image', '.jpeg': 'image', '.gif': 'image', '.svg': 'image',
  '.webp': 'image', '.ico': 'image', '.bmp': 'image',
  '.sql': 'data', '.csv': 'data', '.tsv': 'data',
};
const ASSET_BASENAMES = { // dotfiles / extensionless, matched on lowercase basename
  'dockerfile': 'config', 'makefile': 'config', 'jenkinsfile': 'config',
  '.env': 'config', '.env.local': 'config', '.env.example': 'config', '.env.production': 'config',
};
const ASSET_LAYER = { config: 'Config', doc: 'Doc', image: 'Asset', data: 'Data' };
const MAX_FILE_BYTES = 512 * 1024;

// ---------------------------------------------------------------- walking ---

function fileKind(rel) {
  const ext = path.extname(rel).toLowerCase();
  if (EXT_LANG[ext]) return { kind: 'code', lang: EXT_LANG[ext] };
  const base = path.basename(rel).toLowerCase();
  if (ASSET_BASENAMES[base]) return { kind: ASSET_KIND[ext] || ASSET_BASENAMES[base] };
  if (ASSET_KIND[ext]) return { kind: ASSET_KIND[ext] };
  return null;
}

function walk(dir, root, out) {
  out = out || [];
  let entries;
  try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return out; }
  for (const e of entries) {
    if (e.name.startsWith('.') && e.name !== '.github') {
      if (SKIP_DIRS.has(e.name)) continue;
    }
    if (SKIP_DIRS.has(e.name)) continue;
    const full = path.join(dir, e.name);
    if (e.isDirectory()) walk(full, root, out);
    else if (e.isFile()) {
      const rel = path.relative(root, full);
      if (!fileKind(rel)) continue;
      try {
        const st = fs.statSync(full);
        if (st.size > MAX_FILE_BYTES) continue;
        out.push({ rel, size: st.size });
      } catch { continue; }
    }
  }
  out.sort((a, b) => (a.rel < b.rel ? -1 : 1));
  return out;
}

function summarizeAsset(full, kind, ext) {
  try {
    if (kind === 'config' && ext === '.json') {
      const obj = JSON.parse(fs.readFileSync(full, 'utf8'));
      const keys = Object.keys(obj).slice(0, 8).join(', ');
      return keys ? `keys: ${keys}` : 'empty object';
    }
    if ((kind === 'config' && (ext === '.yaml' || ext === '.yml')) || ext === '.toml') {
      const keys = [...fs.readFileSync(full, 'utf8').matchAll(/^([A-Za-z_][\w-]*):/gm)]
        .map(m => m[1]).slice(0, 8).join(', ');
      return keys ? `keys: ${keys}` : '';
    }
    if (kind === 'doc' && (ext === '.md' || ext === '.mdx')) {
      const heads = [...fs.readFileSync(full, 'utf8').matchAll(/^#{1,3}\s+(.+)$/gm)]
        .map(m => m[1].trim()).slice(0, 5).join(' · ');
      return heads || '';
    }
  } catch { /* binary or unparseable — fall through to size */ }
  return '';
}

function fmtSize(bytes) {
  return bytes < 1024 ? `${bytes} B` : `${(bytes / 1024).toFixed(1)} KB`;
}

// --------------------------------------------------------------- parsing ---

function parseJS(lines) {
  const imports = [], exports = [];
  const reImportFrom = /^\s*import\s+(?:[^'"]*?\s+from\s+)?['"]([^'"]+)['"]/;
  const reExportFrom = /^\s*export\s+(?:[^'"]*?\s+from\s+)['"]([^'"]+)['"]/;
  const reExportStar = /^\s*export\s+\*\s*(?:as\s+[A-Za-z_$][\w$]*\s+)?from\s+['"]([^'"]+)['"]/;
  const reRequire = /(?:^|[^.\w$])require\s*\(\s*['"]([^'"]+)['"]\s*\)/;
  const reDynImport = /(?:^|[^.\w$])import\s*\(\s*['"]([^'"]+)['"]\s*\)/;
  const reExportDecl = /^\s*export\s+(?:default\s+)?(?:async\s+)?(?:function|class|const|let|var)\s+([A-Za-z_$][\w$]*)/;
  const reExportList = /^\s*export\s*\{([^}]*)\}/;
  const reModuleExports = /^\s*(?:module\.exports|exports)(?:\.([A-Za-z_$][\w$]*))?\s*=/;
  lines.forEach((ln, i) => {
    const line = i + 1;
    let m;
    if ((m = ln.match(reExportStar))) imports.push({ raw: m[1], line, reexport: true });
    else if ((m = ln.match(reImportFrom))) imports.push({ raw: m[1], line });
    else if ((m = ln.match(reExportFrom))) { imports.push({ raw: m[1], line, reexport: true }); }
    else if ((m = ln.match(reRequire))) imports.push({ raw: m[1], line });
    else if ((m = ln.match(reDynImport))) imports.push({ raw: m[1], line });
    if ((m = ln.match(reExportDecl))) exports.push(m[1]);
    else if ((m = ln.match(reExportList))) {
      m[1].split(',').forEach(s => {
        const name = s.trim().split(/\s+as\s+/).pop().trim();
        if (/^[A-Za-z_$][\w$]*$/.test(name)) exports.push(name);
      });
    } else if ((m = ln.match(reModuleExports))) exports.push(m[1] || 'module.exports');
  });
  return { imports, exports };
}

function parsePy(lines) {
  const imports = [], exports = [];
  const reImp = /^\s*import\s+([a-zA-Z_][\w.]*(?:\s*,\s*[a-zA-Z_][\w.]*)*)/;
  const reFrom = /^\s*from\s+(\.*[a-zA-Z_]?[\w.]*)\s+import\s+(.+)/;
  const reDef = /^\s*(?:def|class)\s+([A-Za-z_]\w*)/;
  lines.forEach((ln, i) => {
    const line = i + 1;
    let m;
    if ((m = ln.match(reImp))) {
      m[1].split(',').forEach(s => imports.push({ raw: s.trim().split(/\s+as\s+/)[0].trim(), line }));
    } else if ((m = ln.match(reFrom))) {
      const raw = m[1].trim() || '.';
      imports.push({ raw, line, names: m[2].trim(), relative: raw.startsWith('.') });
    } else if ((m = ln.match(reDef)) && !ln.startsWith(' ') && !ln.startsWith('\t')) {
      exports.push(m[1]);
    }
  });
  return { imports, exports };
}

function parseGo(lines) {
  const imports = [], exports = [];
  const reSingle = /^\s*import\s+(?:[\w.]+\s+)?"([^"]+)"/;
  const reBlockItem = /^\s*(?:[\w.]+\s+)?"([^"]+)"\s*$/;
  const reFunc = /^\s*func\s+(?:\([^)]*\)\s+)?([A-Z][\w]*)\s*\(/;
  let inBlock = false;
  lines.forEach((ln, i) => {
    const line = i + 1;
    let m;
    if (/^\s*import\s*\($/.test(ln)) { inBlock = true; return; }
    if (inBlock && /^\s*\)/.test(ln)) { inBlock = false; return; }
    if (inBlock && (m = ln.match(reBlockItem))) { imports.push({ raw: m[1], line }); return; }
    if ((m = ln.match(reSingle))) imports.push({ raw: m[1], line });
    else if ((m = ln.match(reFunc))) exports.push(m[1]);
  });
  return { imports, exports };
}

function parseJava(lines) {
  const imports = [], exports = [];
  const reImp = /^\s*import\s+(?:static\s+)?([\w.]+)(?:\.\*)?;/;
  const reClass = /^\s*(?:public\s+)?(?:final\s+)?(?:class|interface|enum)\s+([A-Za-z_]\w*)/;
  lines.forEach((ln, i) => {
    const line = i + 1;
    let m;
    if ((m = ln.match(reImp))) imports.push({ raw: m[1], line });
    else if ((m = ln.match(reClass))) exports.push(m[1]);
  });
  return { imports, exports };
}

const PARSERS = { javascript: parseJS, typescript: parseJS, python: parsePy, go: parseGo, java: parseJava };

// ------------------------------------------------------------- resolving ---

const CANDIDATE_EXTS = ['', '.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs', '.py', '.go', '.java', '.rb', '.php', '.json'];

function tryFile(root, p) {
  for (const ext of CANDIDATE_EXTS) {
    const c = p + ext;
    try { if (fs.statSync(path.join(root, c)).isFile()) return c; } catch {}
  }
  for (const ext of CANDIDATE_EXTS.slice(1)) {
    const c = path.join(p, 'index' + ext);
    try { if (fs.statSync(path.join(root, c)).isFile()) return c; } catch {}
  }
  return null;
}

function resolveImport(root, fromRel, raw, lang, aliases, names) {
  if (raw.startsWith('.')) {
    // Relative import: ./x, ../x (JS/TS) and .mod, ..pkg, . (python explicit-relative).
    const dots = raw.match(/^(\.+)/)[1].length;
    let rest = raw.slice(dots);
    rest = rest.startsWith('/') ? rest.slice(1) : rest.replace(/\./g, '/');
    let base = path.dirname(fromRel);
    for (let i = 1; i < dots; i++) base = path.dirname(base); // 1 dot = same dir
    if (rest) {
      const hit = tryFile(root, path.join(base, rest));
      // Unresolved relative imports are reported honestly (null) — never
      // guessed. (Falling back to the directory index here would mask broken
      // imports and fabricate cycles.)
      return hit || null;
    }
    if (lang === 'python') {
      if (names) {
        // `from . import x` → sibling module x
        const first = names.split(',')[0].trim().split(/\s+/)[0];
        if (/^[A-Za-z_]\w*$/.test(first)) {
          const hit = tryFile(root, path.join(base, first));
          if (hit) return hit;
        }
      }
      return tryFile(root, path.join(base, '__init__')); // package init fallback
    }
    return null;
  }
  if ((lang === 'javascript' || lang === 'typescript') && aliases) {
    for (const { prefix, target } of aliases) {
      if (raw === prefix || raw.startsWith(prefix + '/')) {
        const hit = tryFile(root, path.join(target, raw.slice(prefix.length)));
        if (hit) return hit;
      }
    }
  }
  if (lang === 'python' && /^[a-zA-Z_][\w.]*$/.test(raw)) {
    // absolute python import: try foo/bar.py, foo/bar/__init__.py (from root,
    // then relative to the importing file for sibling-style imports)
    const base = raw.replace(/\./g, '/');
    return tryFile(root, base) || tryFile(root, path.join(base, '__init__')) ||
      tryFile(root, path.join(path.dirname(fromRel), base));
  }
  return null; // external / bare import
}

function loadAliases(root) {
  // tsconfig.json / jsconfig.json `paths` (e.g. "@/*": ["src/*"]) for JS/TS.
  const aliases = [];
  for (const name of ['tsconfig.json', 'jsconfig.json']) {
    const p = path.join(root, name);
    if (!fs.existsSync(p)) continue;
    try {
      const text = fs.readFileSync(p, 'utf8')
        .replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:])\/\/.*$/gm, '$1');
      const cfg = JSON.parse(text);
      const baseUrl = (cfg.compilerOptions && cfg.compilerOptions.baseUrl) || '.';
      const paths = (cfg.compilerOptions && cfg.compilerOptions.paths) || {};
      for (const [key, vals] of Object.entries(paths)) {
        const prefix = key.replace(/\/\*$/, '');
        const target = (vals[0] || '').replace(/\/\*$/, '');
        if (prefix) aliases.push({ prefix, target: path.normalize(path.join(baseUrl, target)) });
      }
    } catch { /* malformed config — ignore */ }
  }
  return aliases;
}

// ----------------------------------------------------------------- graph ---

function guessLayer(rel, isEntry, isTest) {
  const p = rel.toLowerCase();
  if (isTest) return 'Test';
  if (isEntry) return 'Entry';
  if (/middleware/.test(p)) return 'Middleware';
  if (/(^|\/)(routes?|router|controllers?|handlers?|api|urls\.py|views\.py)(\/|$)/.test(p)) return 'API Route';
  if (/(^|\/)(services?|lib)(\/|$)/.test(p)) return 'Service';
  if (/(^|\/)(models?|schemas?|entities)(\/|$)/.test(p)) return 'Model/Schema';
  if (/(^|\/)(db|database|repositories?|dao)(\/|$)/.test(p)) return 'Data Access';
  if (/(^|\/)(components?|views?|pages?|ui)(\/|$)/.test(p)) return 'UI Component';
  if (/(^|\/)(store|state|context|redux)(\/|$)/.test(p)) return 'State';
  if (/(^|\/)(utils?|helpers?|common|shared)(\/|$)/.test(p)) return 'Shared Utility';
  if (/(^|\/)(config|settings)(\/|$)/.test(p)) return 'Config';
  if (/(^|\/)(scripts?|bin|tools)(\/|$)/.test(p)) return 'Script';
  return 'Domain';
}

function isTestFile(rel) {
  const p = rel.toLowerCase();
  return p.includes('__tests__') || /(^|\/)(test|tests)(\/|$)/.test(p) ||
    /\.(test|spec)\.[a-z]+$/.test(p) || /(^|\/)test_[^/]*\.py$/.test(p) ||
    /_test\.go$/.test(p);
}

function detectEntry(content, lang, rel, ctx) {
  const p = rel.toLowerCase();
  if (lang === 'javascript' || lang === 'typescript') {
    if (/app\.(get|post|put|patch|delete|use|listen)\s*\(/.test(content)) return true; // express
    if (/createBrowserRouter\s*\(/.test(content)) return true; // react-router
    // next.js page routes — only when the repo is actually a Next.js app
    if (ctx.isNextJs && /(^|\/)app\//.test(p) && /page\.[a-z]+$/.test(p)) return true;
    if (/createServer\s*\(/.test(content) || /program\.(command|parse)\s*\(/.test(content)) return true;
    return false;
  }
  if (lang === 'python') {
    if (/if\s+__name__\s*==\s*['"]__main__['"]/.test(content)) return true;
    if (/@app\.(get|post|put|patch|delete|route)\s*\(/.test(content)) return true; // flask/fastapi
    if (/@(router|api)\.(get|post|put|patch|delete|route)\s*\(/.test(content)) return true; // fastapi router
    if (/urlpatterns\s*=/.test(content)) return true; // django urls
    return false;
  }
  if (lang === 'go') return /^\s*func\s+main\s*\(/m.test(content);
  if (lang === 'java') {
    if (/public\s+static\s+void\s+main\s*\(/.test(content)) return true;
    if (/@SpringBootApplication/.test(content)) return true;
    if (/@RestController/.test(content)) return true;
    return false;
  }
  if (lang === 'ruby') {
    if (/Rails\.application\.routes\.draw/.test(content)) return true;
    if (/<\s*ApplicationController/.test(content)) return true;
    return false;
  }
  if (lang === 'php') {
    if (/Route::(get|post|put|patch|delete)\s*\(/.test(content)) return true; // laravel
    if (/Artisan::/.test(content)) return true;
    return false;
  }
  return false;
}

function buildGraph(root, extractedMap) {
  const files = walk(root, root);
  const aliases = loadAliases(root);
  const ctx = {
    // next.js repo signals — gates the app/page.tsx entry heuristic
    isNextJs: ['next.config.js', 'next.config.mjs', 'next.config.ts'].some(f =>
      fs.existsSync(path.join(root, f))),
  };
  const modules = new Map();
  for (const { rel, size } of files) {
    const fk = fileKind(rel);
    const full = path.join(root, rel);
    if (fk.kind !== 'code') {
      // Asset: inventoried, never parsed. Shown in the repo map.
      const ext = path.extname(rel).toLowerCase();
      modules.set(rel, {
        id: rel, path: rel, kind: fk.kind, lang: 'asset',
        lines: 0, size, summary: summarizeAsset(full, fk.kind, ext),
        exports: [], imports: [], isTest: false, isEntry: false,
        layer: ASSET_LAYER[fk.kind], fanIn: 0, fanOut: 0,
      });
      continue;
    }
    const lang = fk.lang;
    let imports, exports, lineCount;
    const te = extractedMap && extractedMap.get(rel);
    if (te) {
      // Tree-sitter AST extraction (zero false positives from comments/strings).
      ({ imports, exports } = te);
      lineCount = te.lines;
    } else {
      const content = fs.readFileSync(full, 'utf8');
      const lines = content.split('\n');
      const parser = PARSERS[lang] || (() => ({ imports: [], exports: [] }));
      ({ imports, exports } = parser(lines));
      lineCount = lines.length;
    }
    const test = isTestFile(rel);
    // Entry detection reuses the heuristic pass (cheap content read; the AST
    // engine's job is import/export accuracy, not entry heuristics).
    let entry = false;
    if (!test) {
      const content = fs.readFileSync(full, 'utf8');
      entry = detectEntry(content, lang, rel, ctx);
    }
    modules.set(rel, {
      id: rel, path: rel, kind: 'code', lang, lines: lineCount,
      exports, isTest: test, isEntry: entry,
      layer: guessLayer(rel, entry, test),
      imports: imports.map(im => ({
        raw: im.raw, line: im.line, reexport: !!im.reexport,
        resolved: resolveImport(root, rel, im.raw, lang, aliases, im.names),
      })),
      fanIn: 0, fanOut: 0,
    });
  }
  const edges = [];
  for (const m of modules.values()) {
    const seen = new Set();
    for (const im of m.imports) {
      if (im.resolved && modules.has(im.resolved) && im.resolved !== m.id && !seen.has(im.resolved)) {
        seen.add(im.resolved);
        edges.push({ from: m.id, to: im.resolved, line: im.line });
        m.fanOut++;
        modules.get(im.resolved).fanIn++;
      }
    }
  }
  // risk: heuristic, documented
  for (const m of modules.values()) {
    let risk = 'LOW';
    if (m.fanIn >= 8) risk = 'CRITICAL';
    else if (m.fanIn >= 4) risk = 'HIGH';
    else if (m.fanIn >= 2) risk = 'MEDIUM';
    m.risk = m.isTest ? 'LOW' : risk;
  }
  const cycles = findCycles([...modules.keys()], edges);
  // Audience settings (see `codequest init`): prompts adapt explanations to it.
  let audience = 'professional', businessLens = false;
  try {
    const cfg = JSON.parse(fs.readFileSync(path.join(root, '.codequest', 'config.json'), 'utf8'));
    if (cfg.audience) audience = cfg.audience;
    if (cfg.businessLens) businessLens = true;
  } catch { /* no config — defaults */ }
  return {
    version: VERSION, root: path.resolve(root), generatedAt: new Date().toISOString(),
    audience, businessLens,
    modules: [...modules.values()], edges, cycles,
  };
}

function findCycles(nodeIds, edges) {
  const adj = new Map(nodeIds.map(id => [id, []]));
  for (const e of edges) adj.get(e.from).push(e.to);
  const cycles = [];
  const visited = new Set(), onStack = new Set(), stack = [];
  const canon = (cyc) => {
    const inner = cyc.slice(0, -1);
    const min = inner.reduce((a, b) => (a < b ? a : b));
    const i = inner.indexOf(min);
    return [...inner.slice(i), ...inner.slice(0, i), min].join('>');
  };
  const seen = new Set();
  function dfs(n) {
    visited.add(n); onStack.add(n); stack.push(n);
    for (const t of adj.get(n) || []) {
      if (!visited.has(t)) dfs(t);
      else if (onStack.has(t)) {
        const cyc = [...stack.slice(stack.indexOf(t)), t];
        const key = canon(cyc);
        if (!seen.has(key)) { seen.add(key); cycles.push(cyc); }
      }
    }
    stack.pop(); onStack.delete(n);
  }
  for (const id of nodeIds) if (!visited.has(id)) dfs(id);
  return cycles.slice(0, 20);
}

// --------------------------------------------------------------- commands ---

const RISK_RANK = { LOW: 0, MEDIUM: 1, HIGH: 2, CRITICAL: 3 };

function runTreeSitterExtract(dir) {
  const engine = path.join(__dirname, '..', 'parsers', 'tree-sitter', 'extract.js');
  if (!fs.existsSync(path.join(path.dirname(engine), 'node_modules'))) {
    console.error('codequest: the tree-sitter engine needs its dependencies:\n' +
      '  cd codequest/parsers/tree-sitter && npm install   (try --legacy-peer-deps on conflict)');
    process.exit(2);
  }
  const out = execFileSync(process.execPath, [engine, dir],
    { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
  return new Map(JSON.parse(out).map(e => [e.rel, e]));
}

function loadGraphInput(input) {
  // Accepts a directory (uses .codequest/graph.json) or a graph.json path.
  const p = fs.existsSync(input) && fs.statSync(input).isDirectory()
    ? path.join(input, '.codequest', 'graph.json') : input;
  if (!fs.existsSync(p)) {
    console.error(`codequest: no graph found at ${p} — run \`codequest scan\` first.`);
    process.exit(1);
  }
  return JSON.parse(fs.readFileSync(p, 'utf8'));
}

function cmdDiff(oldInput, newInput, asJson, failOn) {
  const og = loadGraphInput(oldInput), ng = loadGraphInput(newInput);
  const om = new Map(og.modules.map(m => [m.id, m]));
  const nm = new Map(ng.modules.map(m => [m.id, m]));
  const addedModules = ng.modules.filter(m => !om.has(m.id)).map(m => m.id);
  const removedModules = og.modules.filter(m => !nm.has(m.id)).map(m => m.id);
  const ekey = (e) => `${e.from}→${e.to}`;
  const oe = new Set(og.edges.map(ekey)), ne = new Set(ng.edges.map(ekey));
  const addedEdges = ng.edges.filter(e => !oe.has(ekey(e)));
  const removedEdges = og.edges.filter(e => !ne.has(ekey(e)));
  const escalations = ng.modules
    .filter(m => om.has(m.id) && RISK_RANK[m.risk] > RISK_RANK[om.get(m.id).risk])
    .map(m => ({ module: m.id, from: om.get(m.id).risk, to: m.risk }));
  const newCritical = ng.modules
    .filter(m => !om.has(m.id) && RISK_RANK[m.risk] >= RISK_RANK.HIGH)
    .map(m => ({ module: m.id, risk: m.risk, fanIn: m.fanIn }));
  const oldCyc = new Set((og.cycles || []).map(c => c.join('>')));
  const newCycles = (ng.cycles || []).filter(c => !oldCyc.has(c.join('>')));
  const newEntries = ng.modules.filter(m => m.isEntry && !(om.has(m.id) && om.get(m.id).isEntry)).map(m => m.id);

  const failures = [];
  if (failOn.includes('critical') && (newCritical.length || escalations.some(e => e.to === 'CRITICAL')))
    failures.push('new/escalated CRITICAL-risk modules');
  if (failOn.includes('cycles') && newCycles.length) failures.push('new circular imports');
  if (failOn.includes('escalations') && escalations.length) failures.push('risk escalations');

  const result = { addedModules, removedModules, addedEdges, removedEdges,
    escalations, newCritical, newCycles, newEntries, failures };
  if (asJson) { out(JSON.stringify(result, null, 2)); }
  else {
    const L = ['# CodeQuest architecture drift'];
    const sec = (t, items, fmt) => {
      L.push('', `## ${t} (${items.length})`);
      L.push(items.length ? items.slice(0, 20).map(fmt).join('\n') : '- none');
    };
    sec('Added modules', addedModules, (m) => `- ${m}`);
    sec('Removed modules', removedModules, (m) => `- ${m}`);
    sec('Added edges', addedEdges, (e) => `- ${e.from}:${e.line} → ${e.to}`);
    sec('Removed edges', removedEdges, (e) => `- ${e.from} → ${e.to}`);
    sec('Risk escalations', escalations, (e) => `- ${e.module}: ${e.from} → [${e.to} RISK]`);
    sec('New HIGH/CRITICAL modules', newCritical, (m) => `- ${m.module} [${m.risk} RISK] (fan-in ${m.fanIn})`);
    sec('New circular imports', newCycles, (c) => `- ${c.join(' → ')}`);
    sec('New entry points', newEntries, (m) => `- ${m}`);
    L.push('', failures.length ? `RESULT: FAIL — ${failures.join('; ')}` : 'RESULT: PASS — no blocking drift');
    out(L.join('\n'));
  }
  if (failures.length) process.exitCode = 1;
}

// ------------------------------------------------- environment setup ---

function detectEnvironment() {
  const os = require('os');
  const { execSync } = require('child_process');
  const platform = os.platform();
  const home = os.homedir();
  const ides = [], assistants = [], notes = [];
  const hasBin = (name) => {
    try {
      execSync(platform === 'win32' ? `where ${name}` : `command -v ${name}`, { stdio: 'pipe' });
      return true;
    } catch { return false; }
  };
  const exists = (p) => { try { return fs.existsSync(p); } catch { return false; } };

  // VS Code (+ Copilot / Tabnine via extensions)
  const vscodeUser = platform === 'darwin' ? path.join(home, 'Library/Application Support/Code')
    : platform === 'win32' ? path.join(process.env.APPDATA || '', 'Code')
    : path.join(home, '.config/Code');
  if (hasBin('code') || exists(vscodeUser)) {
    ides.push({ id: 'vscode', name: 'VS Code' });
    try {
      const exts = fs.readdirSync(path.join(vscodeUser, 'extensions'));
      if (exts.some(e => e.startsWith('github.copilot'))) {
        assistants.push({ id: 'copilot', name: 'GitHub Copilot', via: 'VS Code' });
      }
      if (exts.some(e => e.toLowerCase().startsWith('tabnine'))) {
        assistants.push({ id: 'tabnine', name: 'Tabnine', via: 'VS Code' });
      }
    } catch { /* no extensions dir */ }
  }
  if (hasBin('code-insiders')) ides.push({ id: 'vscode-insiders', name: 'VS Code Insiders' });
  // Cursor (AI built in)
  if (hasBin('cursor') || exists(path.join(home, '.cursor'))) {
    ides.push({ id: 'cursor', name: 'Cursor' });
    assistants.push({ id: 'cursor-ai', name: 'Cursor AI', via: 'built-in' });
  }
  // Windsurf (AI built in)
  if (hasBin('windsurf') || exists(path.join(home, '.codeium'))) {
    ides.push({ id: 'windsurf', name: 'Windsurf' });
    assistants.push({ id: 'windsurf-ai', name: 'Windsurf AI', via: 'built-in' });
  }
  // Zed (AI built in)
  if (hasBin('zed')) {
    ides.push({ id: 'zed', name: 'Zed' });
    assistants.push({ id: 'zed-ai', name: 'Zed AI', via: 'built-in' });
  }
  // JetBrains (AI Assistant / Junie read AGENTS.md)
  const jb = platform === 'darwin'
    ? path.join(home, 'Library/Application Support/JetBrains')
    : path.join(home, '.config/JetBrains');
  if (exists(jb) || hasBin('idea') || hasBin('pycharm') || hasBin('webstorm')) {
    ides.push({ id: 'jetbrains', name: 'JetBrains IDEs' });
    notes.push('JetBrains: AGENTS.md is picked up by AI Assistant / Junie automatically.');
  }
  // Neovim / Vim (no standard config — AGENTS.md is the bridge)
  if (hasBin('nvim') || hasBin('vim')) {
    ides.push({ id: 'neovim', name: 'Neovim/Vim' });
    notes.push('Neovim/Vim: no standard agent-config location — AGENTS.md at repo root is read by most AI plugins.');
  }
  // Sublime
  if (hasBin('subl')) ides.push({ id: 'sublime', name: 'Sublime Text' });
  // Amazon Q CLI
  if (hasBin('q')) assistants.push({ id: 'amazon-q', name: 'Amazon Q', via: 'CLI' });

  if (!assistants.length) {
    notes.push('No AI assistant detected — the pack is model-agnostic and works with any you install later.');
  }
  notes.push('The pack works with every model your assistant offers (GPT, Claude, Gemini…) — no model-specific setup.');
  return { platform, ides, assistants, notes };
}

function copyMissing(src, dst) {
  // Copy a file or directory tree, never overwriting existing files. Returns files written.
  const written = [];
  const st = fs.statSync(src);
  if (st.isDirectory()) {
    fs.mkdirSync(dst, { recursive: true });
    for (const e of fs.readdirSync(src)) {
      written.push(...copyMissing(path.join(src, e), path.join(dst, e)));
    }
  } else if (!fs.existsSync(dst)) {
    fs.mkdirSync(path.dirname(dst), { recursive: true });
    fs.copyFileSync(src, dst);
    written.push(path.relative(process.cwd(), dst));
  }
  return written;
}

function mergeMcpJson(dst, packExample) {
  const server = {
    type: 'stdio', command: 'node',
    args: ['${workspaceFolder}/codequest/mcp-server.js'],
  };
  let cfg = { servers: {} };
  let existed = fs.existsSync(dst);
  if (existed) {
    try { cfg = JSON.parse(fs.readFileSync(dst, 'utf8')); } catch { cfg = { servers: {} }; }
    cfg.servers = cfg.servers || {};
  }
  const had = !!(cfg.servers && cfg.servers.codequest);
  if (!had) {
    cfg.servers.codequest = server;
    fs.mkdirSync(path.dirname(dst), { recursive: true });
    fs.writeFileSync(dst, JSON.stringify(cfg, null, 2) + '\n');
  }
  return had ? 'exists' : (existed ? 'merged' : 'created');
}

const CURSOR_RULE = `---
description: CodeQuest repo intelligence — master prompt pointer
globs:
  - "**/*"
alwaysApply: true
---

# CodeQuest (Cursor)

You are **CodeQuest Core AI**. Read \`codequest/CODEQUEST.md\` — it is your contract —
plus \`.codequest/config.json\` for the audience setting (beginner/professional/expert,
businessLens) and adapt every explanation to it.

Boot: run \`./codequest/bin/codequest scan\` (or read \`.codequest/graph.json\`);
prefer the \`codequest_*\` MCP tools when configured; never fabricate a dependency —
every structural claim carries a \`file:line\` receipt.
`;

const WINDSURF_RULE = `# CodeQuest (Windsurf)

You are **CodeQuest Core AI**. Read \`codequest/CODEQUEST.md\` — it is your contract —
plus \`.codequest/config.json\` for the audience setting (beginner/professional/expert,
businessLens) and adapt every explanation to it.

Boot: run \`./codequest/bin/codequest scan\` (or read \`.codequest/graph.json\`);
prefer the \`codequest_*\` MCP tools when configured; never fabricate a dependency —
every structural claim carries a \`file:line\` receipt.
`;

function cmdSetup(dir, packDir, asJson, flags) {
  const env = detectEnvironment();
  const ALL = ['vscode', 'cursor', 'windsurf'];
  let targets = flags.all ? ALL.slice()
    : flags.ide ? String(flags.ide).split(',').map(s => s.trim()).filter(Boolean)
    : env.ides.map(d => d.id).filter(id => ALL.includes(id) || id === 'vscode-insiders');
  if (flags.ide) targets = targets.filter(t => ALL.includes(t) || t === 'vscode-insiders');
  const written = [], skipped = [];
  const put = (repoRel, content) => {
    const full = path.join(dir, repoRel);
    if (flags['dry-run']) { written.push(repoRel + '  (dry-run)'); return; }
    if (fs.existsSync(full)) { skipped.push(repoRel); return; }
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, content);
    written.push(repoRel);
  };

  // 1. Root AGENTS.md — universal bridge (Copilot, Cursor, Junie, Amp, Zed, …).
  const packAgents = path.join(packDir, 'AGENTS.md');
  if (fs.existsSync(packAgents)) {
    if (flags['dry-run']) written.push('AGENTS.md  (dry-run)');
    else if (!fs.existsSync(path.join(dir, 'AGENTS.md'))) {
      fs.copyFileSync(packAgents, path.join(dir, 'AGENTS.md'));
      written.push('AGENTS.md');
    } else skipped.push('AGENTS.md');
  }

  // 2. Per-IDE configuration.
  const mcpStates = [];
  if (targets.includes('vscode') || targets.includes('vscode-insiders')) {
    for (const f of ['muse-instructions.md', 'agents/codequest.agent.md',
        'instructions/codequest.instructions.md']) {
      const src = path.join(packDir, '.github', ...f.split('/'));
      if (fs.existsSync(src)) {
        const rel = path.join('.github', ...f.split('/'));
        if (flags['dry-run']) written.push(rel + '  (dry-run)');
        else written.push(...copyMissing(src, path.join(dir, rel)));
      }
    }
    const promptsSrc = path.join(packDir, '.github', 'prompts');
    if (fs.existsSync(promptsSrc)) {
      if (flags['dry-run']) written.push('.github/prompts/  (dry-run)');
      else for (const f of copyMissing(promptsSrc, path.join(dir, '.github', 'prompts'))) written.push(f);
    }
    if (!flags['dry-run']) mcpStates.push('.vscode/mcp.json: ' + mergeMcpJson(path.join(dir, '.vscode', 'mcp.json'), packDir));
    else written.push('.vscode/mcp.json  (dry-run)');
  }
  if (targets.includes('cursor')) {
    put('.cursor/rules/codequest.mdc', CURSOR_RULE);
    if (!flags['dry-run']) mcpStates.push('.cursor/mcp.json: ' + mergeMcpJson(path.join(dir, '.cursor', 'mcp.json'), packDir));
    else written.push('.cursor/mcp.json  (dry-run)');
  }
  if (targets.includes('windsurf')) {
    put('.windsurf/rules/codequest.md', WINDSURF_RULE);
    if (!flags['dry-run']) mcpStates.push('.windsurf/mcp.json: ' + mergeMcpJson(path.join(dir, '.windsurf', 'mcp.json'), packDir));
    else written.push('.windsurf/mcp.json  (dry-run)');
  }

  const setupRecord = {
    at: new Date().toISOString(), version: VERSION,
    detected: { ides: env.ides, assistants: env.assistants },
    configured: targets, written: written.filter(w => !w.includes('dry-run')),
    notes: env.notes,
  };
  if (!flags['dry-run']) {
    fs.mkdirSync(path.join(dir, '.codequest'), { recursive: true });
    fs.writeFileSync(path.join(dir, '.codequest', 'setup.json'), JSON.stringify(setupRecord, null, 2));
  }

  if (asJson) return out(JSON.stringify(setupRecord, null, 2));
  const L = ['# CodeQuest setup', ''];
  L.push(`Detected IDEs: ${env.ides.length ? env.ides.map(i => i.name).join(', ') : '(none)'}`);
  L.push(`Detected AI assistants: ${env.assistants.length ? env.assistants.map(a => `${a.name} (${a.via})`).join(', ') : '(none)'}`);
  L.push(`Configured for: ${targets.length ? targets.join(', ') : '(none — use --all or --ide)'}`);
  L.push('');
  L.push(`Wrote ${written.length} file(s):`);
  written.slice(0, 25).forEach(w => L.push(`  + ${w}`));
  if (written.length > 25) L.push(`  …and ${written.length - 25} more`);
  if (skipped.length) { L.push('', `Skipped (already exist): ${skipped.slice(0, 10).join(', ')}${skipped.length > 10 ? '…' : ''}`); }
  if (mcpStates.length) { L.push('', 'MCP:'); mcpStates.forEach(s => L.push(`  ${s}`)); }
  if (env.notes.length) { L.push('', 'Notes:'); env.notes.forEach(n => L.push(`  - ${n}`)); }
  return out(L.join('\n'));
}

function cmdHistory(dir, asJson) {
  const g = loadGraphInput(dir);
  const snap = {
    at: new Date().toISOString(),
    modules: g.modules.length, edges: g.edges.length,
    cycles: (g.cycles || []).length,
    entries: g.modules.filter(m => m.isEntry).length,
    critical: g.modules.filter(m => m.risk === 'CRITICAL').length,
    high: g.modules.filter(m => m.risk === 'HIGH').length,
    engine: g.engine || 'regex',
  };
  const p = path.join(dir, '.codequest', 'history.jsonl');
  fs.appendFileSync(p, JSON.stringify(snap) + '\n');
  if (asJson) return out(JSON.stringify(snap, null, 2));
  return out(`codequest: snapshot recorded → .codequest/history.jsonl (${snap.modules} modules, ${snap.critical} critical)`);
}

function cmdTrends(dir, asJson) {
  const p = path.join(dir, '.codequest', 'history.jsonl');
  if (!fs.existsSync(p)) return fail('no history yet — run `codequest history` to record snapshots', asJson);
  const snaps = fs.readFileSync(p, 'utf8').trim().split('\n').filter(Boolean).map(l => JSON.parse(l));
  if (asJson) return out(JSON.stringify(snaps, null, 2));
  const L = ['# CodeQuest drift history', '',
    '| Snapshot | Modules | Edges | Cycles | Entries | CRITICAL | HIGH |',
    '|---|---|---|---|---|---|---|'];
  snaps.forEach((s, i) => {
    const prev = snaps[i - 1];
    const d = (k) => prev ? (s[k] - prev[k] >= 0 ? `+${s[k] - prev[k]}` : `${s[k] - prev[k]}`) : '—';
    L.push(`| ${s.at.slice(0, 10)} | ${s.modules} (${d('modules')}) | ${s.edges} (${d('edges')}) | ${s.cycles} | ${s.entries} | ${s.critical} (${d('critical')}) | ${s.high} (${d('high')}) |`);
  });
  return out(L.join('\n'));
}

function dependentsOf(g, id, maxDepth) {
  const byTarget = new Map();
  for (const e of g.edges) {
    if (!byTarget.has(e.to)) byTarget.set(e.to, []);
    byTarget.get(e.to).push(e);
  }
  const levels = []; const seen = new Set([id]);
  let frontier = [id];
  for (let d = 1; d <= maxDepth; d++) {
    const next = [];
    for (const cur of frontier) {
      for (const e of (byTarget.get(cur) || [])) {
        if (!seen.has(e.from)) { seen.add(e.from); next.push(e.from); }
      }
    }
    if (!next.length) break;
    levels.push(next); frontier = next;
  }
  return levels;
}

function findModule(g, query) {
  const q = query.toLowerCase();
  const exact = g.modules.find(m => m.id.toLowerCase() === q);
  if (exact) return exact;
  const hits = g.modules.filter(m => m.id.toLowerCase().includes(q));
  if (hits.length === 1) return hits[0];
  if (!hits.length) return null;
  return { ambiguous: hits.map(h => h.id) };
}

function modById(g, id) { return g.modules.find(m => m.id === id); }

function cmdBlastRadius(g, target, asJson) {
  const mod = findModule(g, target);
  if (!mod) return fail(`No module matching "${target}"`, asJson);
  if (mod.ambiguous) return fail(`Ambiguous — matches:\n  ${mod.ambiguous.join('\n  ')}`, asJson);
  const upstream = mod.imports.filter(i => i.resolved && modById(g, i.resolved))
    .map(i => ({ file: i.resolved, line: i.line }));
  const levels = dependentsOf(g, mod.id, 3);
  const allDown = levels.flat();
  const tests = allDown.map(id => modById(g, id)).filter(m => m && m.isTest).map(m => m.id);
  const result = {
    module: mod.id, layer: mod.layer, risk: mod.risk,
    fanIn: mod.fanIn, fanOut: mod.fanOut,
    upstream,
    downstream: levels.map((ids, i) => ({ degree: i + 1, modules: ids })),
    affectedTests: tests,
  };
  if (asJson) return out(JSON.stringify(result, null, 2));
  const L = [];
  L.push(`# Blast radius — ${mod.id}`);
  L.push(`Layer: ${mod.layer}   Risk: [${mod.risk} RISK]   fan-in ${mod.fanIn} / fan-out ${mod.fanOut}`);
  L.push('');
  L.push('## Upstream (what this module imports)');
  L.push(upstream.length ? upstream.map(u => `- ${u.file}:${u.line}`).join('\n') : '- (none — leaf or external-only)');
  levels.forEach((ids, i) => {
    L.push('');
    L.push(`## ${['1st','2nd','3rd'][i]}-degree downstream (${ids.length} module${ids.length === 1 ? '' : 's'})`);
    L.push(ids.map(id => `- ${id}`).join('\n'));
  });
  L.push('');
  L.push('## Affected tests');
  L.push(tests.length ? tests.map(t => `- ${t}`).join('\n') : '- (none found — coverage gap)');
  L.push('');
  L.push(`## Flow\n[${mod.id}]`);
  if (levels[0]) levels[0].slice(0, 8).forEach(id => L.push(`   ↑ imported by ${id}`));
  return out(L.join('\n'));
}

function cmdStory(g, entryQ, asJson) {
  const mod = findModule(g, entryQ);
  if (!mod) return fail(`No module matching "${entryQ}"`, asJson);
  if (mod.ambiguous) return fail(`Ambiguous — matches:\n  ${mod.ambiguous.join('\n  ')}`, asJson);
  const steps = []; const visited = new Set();
  const queue = [{ id: mod.id, via: null }];
  while (queue.length && steps.length < 30) {
    const cur = queue.shift();
    if (visited.has(cur.id)) continue;
    visited.add(cur.id);
    const m = modById(g, cur.id);
    steps.push({ n: steps.length + 1, file: m.id, via: cur.via, layer: m.layer });
    for (const im of m.imports) {
      if (im.resolved && modById(g, im.resolved) && !visited.has(im.resolved)) {
        queue.push({ id: im.resolved, via: { from: m.id, line: im.line } });
      }
    }
  }
  if (asJson) return out(JSON.stringify({ entry: mod.id, steps, note: 'static dependency trace' }, null, 2));
  const L = [`# Story — static dependency trace from ${mod.id}`, ''];
  for (const s of steps) {
    const via = s.via ? `  (via ${s.via.from}:${s.via.line})` : '  (entry point)';
    L.push(`${s.n}. [${s.layer}] ${s.file}${via}`);
  }
  L.push('', '_Static dependency trace — data flow inferred from imports, not observed at runtime._');
  return out(L.join('\n'));
}

function riskTag(r) { return `[${r} RISK]`; }

function repoMapMd(g) {
  const L = [];
  const langs = {};
  const code = g.modules.filter(m => m.kind === 'code' || !m.kind);
  const assets = g.modules.filter(m => m.kind && m.kind !== 'code');
  code.forEach(m => { langs[m.lang] = (langs[m.lang] || 0) + 1; });
  const central = [...code].sort((a, b) => b.fanIn - a.fanIn).slice(0, 10);
  const entries = code.filter(m => m.isEntry);
  L.push(`# CodeQuest repo map`, '');
  L.push(`- Modules: ${g.modules.length} (${code.length} code, ${assets.length} assets)   Edges: ${g.edges.length}`);
  L.push(`- Languages: ${Object.entries(langs).map(([k, v]) => `${k} (${v})`).join(', ')}`);
  L.push(`- Audience: ${g.audience || 'professional'}${g.businessLens ? ' · business lens ON' : ''}`);
  L.push(`- Engine: ${g.engine || 'regex'}${g.engine === 'tree-sitter' ? ' (AST)' : ' (zero-dep scanner)'}`);
  L.push(`- Generated: ${g.generatedAt} (codequest ${g.version}, deterministic static scan)`, '');
  L.push('## Entry points');
  L.push(entries.length ? entries.map(m => `- ${m.id} (${m.lang})`).join('\n') : '- (none detected)');
  L.push('', '## Most central modules (by dependents)');
  L.push('| Module | Layer | Dependents | Risk |');
  L.push('|---|---|---|---|');
  central.forEach(m => L.push(`| ${m.id} | ${m.layer} | ${m.fanIn} | ${riskTag(m.risk)} |`));
  L.push('', '## All modules');
  L.push('| Module | Lang | Layer | Exports | In/Out | Risk |');
  L.push('|---|---|---|---|---|---|');
  code.forEach(m => L.push(`| ${m.id} | ${m.lang} | ${m.layer} | ${m.exports.length} | ${m.fanIn}/${m.fanOut} | ${riskTag(m.risk)} |`));
  if (assets.length) {
    L.push('', `## Assets, configs & docs (${assets.length})`);
    L.push('| Path | Kind | Detail |');
    L.push('|---|---|---|');
    assets.forEach(m => {
      const detail = m.summary || fmtSize(m.size || 0);
      L.push(`| ${m.id} | ${m.kind} | ${detail} |`);
    });
  }
  if (g.cycles && g.cycles.length) {
    L.push('', `## Circular imports (${g.cycles.length})`);
    g.cycles.forEach(c => L.push(`- ${c.join(' → ')}`));
  }
  return L.join('\n');
}

function fail(msg, asJson) {
  if (asJson) return out(JSON.stringify({ error: msg }));
  console.error('codequest: ' + msg);
  process.exitCode = 1;
}
function out(s) { console.log(s); }

// ------------------------------------------------------------------ main ---

function main() {
  const rawArgs = process.argv.slice(2);
  // Clean arg parsing: positionals vs --flags (both --flag=value and --flag value).
  const positionals = [];
  const flags = {};
  for (let i = 0; i < rawArgs.length; i++) {
    const a = rawArgs[i];
    if (a === '--json' || a === '--business' || a === '--force' || a === '--dry-run' || a === '--all') {
      flags[a.slice(2)] = true; continue;
    }
    if (a.startsWith('--')) {
      const eq = a.indexOf('=');
      if (eq >= 0) flags[a.slice(2, eq)] = a.slice(eq + 1);
      else { flags[a.slice(2)] = rawArgs[i + 1]; i++; }
      continue;
    }
    positionals.push(a);
  }
  const asJson = !!flags.json;
  const failOn = (flags['fail-on'] || 'critical,cycles').split(',');
  const args = positionals;
  // NOTE: flag *values* (e.g. "beginner" after --audience) are filtered by dirOf-safe logic below.
  const cmd = args[0];

  if (!cmd || cmd === '--help' || cmd === '-h' || cmd === 'help') {
    return out([
      'codequest — deterministic static analyzer (offline, zero deps)',
      '',
      '  scan [dir]               build .codequest/graph.json + repo-map.md',
      '  map [dir]                print the repo map',
      '  modules [dir]            list modules + exports',
      '  blast-radius <file> [dir]',
      '  story <entry-file> [dir]',
      '  diff <old> <new>            architecture drift: old/new are dirs or graph.json paths',
      '  init [dir]                 write .codequest/config.json (audience + perspective)',
      '  setup [dir]                detect local IDEs/AI assistants and configure each one',
      '  history [dir]              record a drift snapshot (.codequest/history.jsonl)',
      '  trends [dir]               show drift history over time',
      '',
      'Add --json for machine-readable output.',
      'diff honors --fail-on <list>: comma list of critical,cycles,escalations (default: critical,cycles).',
      'init honors --audience <beginner|professional|expert> and --business (non-technical lens).',
      'setup honors --dry-run, --all, --ide <vscode,cursor,windsurf>.',
      'scan honors --engine <regex|tree-sitter> (tree-sitter needs parsers/tree-sitter npm install).',
    ].join('\n'));
  }

  const dirOf = (i) => path.resolve(args[i] || '.');
  const loadGraph = (dir) => {
    const p = path.join(dir, '.codequest', 'graph.json');
    if (!fs.existsSync(p)) {
      console.error('codequest: no .codequest/graph.json — run `codequest scan` first.');
      process.exit(1);
    }
    return JSON.parse(fs.readFileSync(p, 'utf8'));
  };

  if (cmd === 'scan') {
    const dir = dirOf(1);
    const engine = flags.engine || 'regex';
    if (engine !== 'regex' && engine !== 'tree-sitter') {
      return fail('engine must be regex or tree-sitter', asJson);
    }
    const extracted = engine === 'tree-sitter' ? runTreeSitterExtract(dir) : null;
    const g = buildGraph(dir, extracted);
    g.engine = engine;
    const cq = path.join(dir, '.codequest');
    fs.mkdirSync(cq, { recursive: true });
    fs.writeFileSync(path.join(cq, 'graph.json'), JSON.stringify(g, null, 2));
    fs.writeFileSync(path.join(cq, 'repo-map.md'), repoMapMd(g));
    const entryN = g.modules.filter(m => m.isEntry).length;
    return out(asJson
      ? JSON.stringify({ modules: g.modules.length, edges: g.edges.length, entries: entryN, engine })
      : `codequest: scanned ${g.modules.length} modules, ${g.edges.length} import edges, ${entryN} entr${entryN === 1 ? 'y' : 'ies'} [engine: ${engine}] → .codequest/`);
  }
  if (cmd === 'map') return out(asJson
    ? JSON.stringify(loadGraph(dirOf(1)), null, 2)
    : repoMapMd(loadGraph(dirOf(1))));
  if (cmd === 'modules') {
    const g = loadGraph(dirOf(1));
    if (asJson) return out(JSON.stringify(g.modules.map(m => ({
      id: m.id, lang: m.lang, layer: m.layer, exports: m.exports,
      fanIn: m.fanIn, fanOut: m.fanOut, risk: m.risk,
    })), null, 2));
    return out(g.modules.map(m =>
      `${m.id}  [${m.lang}/${m.layer}]  exports: ${m.exports.join(', ') || '—'}  in/out ${m.fanIn}/${m.fanOut}  ${riskTag(m.risk)}`
    ).join('\n'));
  }
  if (cmd === 'blast-radius') {
    if (!args[1]) return fail('usage: codequest blast-radius <file> [dir]', asJson);
    return cmdBlastRadius(loadGraph(dirOf(2)), args[1], asJson);
  }
  if (cmd === 'story') {
    if (!args[1]) return fail('usage: codequest story <entry-file> [dir]', asJson);
    return cmdStory(loadGraph(dirOf(2)), args[1], asJson);
  }
  if (cmd === 'diff') {
    if (!args[1] || !args[2]) return fail('usage: codequest diff <old> <new>  (dirs or graph.json paths)', asJson);
    return cmdDiff(args[1], args[2], asJson, failOn);
  }
  if (cmd === 'init') {
    const dir = dirOf(1);
    const audience = flags.audience || 'professional';
    if (!['beginner', 'professional', 'expert'].includes(audience)) {
      return fail('audience must be beginner, professional, or expert', asJson);
    }
    const businessLens = !!flags.business;
    const cq = path.join(dir, '.codequest');
    fs.mkdirSync(cq, { recursive: true });
    const p = path.join(cq, 'config.json');
    if (fs.existsSync(p) && !rawArgs.includes('--force')) {
      return fail(`config exists at ${p} — edit it directly or re-run with --force`, asJson);
    }
    const cfg = {
      audience, businessLens, version: VERSION,
      _comment: 'audience: beginner | professional | expert. businessLens: true = non-technical business perspective.',
    };
    fs.writeFileSync(p, JSON.stringify(cfg, null, 2) + '\n');
    return out(asJson ? JSON.stringify(cfg, null, 2)
      : `codequest: wrote ${p}\n  audience=${audience}  businessLens=${businessLens}\n  Copilot adapts explanations to this. Re-run scan to refresh the map.`);
  }
  if (cmd === 'setup') {
    const packDir = path.join(__dirname, '..'); // codequest/bin/codequest → codequest/
    return cmdSetup(dirOf(1), packDir, asJson, flags);
  }
  if (cmd === 'history') return cmdHistory(dirOf(1), asJson);
  if (cmd === 'trends') return cmdTrends(dirOf(1), asJson);
  return fail(`unknown command "${cmd}" — try --help`, asJson);
}

main();
